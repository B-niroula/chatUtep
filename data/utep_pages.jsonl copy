ndow.location = $(this).find(\"a\").attr(\"href\"); \n          return false;\n        }); UTEP Commencement Commencement 2025 Fall Commencement Saturday, December 13, 2025 and Sunday, December 14, 2025 Location: Don Haskins Center [Map/Directions] Ceremony Program Clear Bag Policy Prohibited Items Saturday, December 13, 2025 1 p.m.- College of Education and College of Engineering [Livestream] 6 p.m.- College of Liberal Arts [Livestream] Sunday, December 14, 2025 1 p.m.- College of Science, Woody L. Hunt College of Business, and School of Pharmacy [Livestream] 6 p.m.- College of Health Sciences and College of Nursing [Livestream] Please contact Records and Registration for any other information by calling 915-747-5544 or email records@utep.edu // \ndocument.getElementsByClassName('carousel-caption ')[0].style.display = 'none';\n// About Undergraduate Admissions Graduate Admissions $(\".dropdown-menu a[href^='http://']\").attr(\"target\",\"_blank\");\n$(\".dropdown-menu a[href^='https://']\").attr(\"target\",\"_blank\");\n$(\".leftSidebar .nav a[href^='http://']\").attr(\"target\",\"_blank\");\n$(\".leftSidebar .nav a[href^='https://']\").attr(\"target\",\"_blank\");\n$('.dropdown-menu a[href*=\".pdf\"]').attr(\"target\",\"_blank\");\n$('.leftSidebar .nav a[href*=\".pdf\"]').attr(\"target\",\"_blank\");\n$(\".carousel-caption a[href^='http://']\").attr(\"target\",\"_blank\");\n$(\".carousel-caption a[href^='https://']\").attr(\"target\",\"_blank\");\n$('.carousel-caption a[href*=\".pdf\"]').attr(\"target\",\"_blank\"); <!--\n:target { \n        padding-top: 133px;\n        margin-top: -133px; \n    }\n    \n    :target:before {\n        content:\"\";\n        display:block;\n        height:133px; /* fixed header height */\n        margin:-133px 0 0; /* negative fixed header height It should be -133 but reduced 20 because of the h2 margin*/\n    }\n--> Connect With Us The University of Texas at El Paso University Events Prospect Hall, Room 227 601 Circle Drive El Paso