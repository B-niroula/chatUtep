ortant;\n    }\n    \n    #imageSection {\n        margin-top: -155px;\n    }\n    .fw-section .btn-primary-1, .fw-section a.btn-primary-1 {\n    background-color: #edf2f9;\n    color: #fa9b49 !important;\n    font-weight: bold;\n    text-transform: uppercase;\n    text-align: center;\n    border: none;\n    letter-spacing: 1px;\n    padding: 15px;\n    font-size: 16px;\n    margin: 12px auto 0;\n    border-radius: 6px !important;\n}\n.fw-section .btn-primary-1:hover, .fw-section a.btn-primary-1:hover {\n    background-color: #ff8200;\n    color: #041e42 !important;\n} UTEP Health is backed by a generous $4.5 million grant over four years from the Paso del Norte Health Foundation. This is a matching grant, which means we are seeking another $4.5 million in matching gifts for a total impact of $9 million. The money will be used for three main projects: Increase the number of nursing faculty so we can grow the nursing program by 100 students Increase the number of occupational therapy faculty to double the number of students in the Doctor of Occupational Therapy program Upgrade the Simulation Lab to better educate and train UTEP Health students If you would like to contribute to the matching grant or support the education of the Paso del Norte region's future healthcare professionals in other ways, complete the short form below and we will contact you. <!--\n.fw-section {\n    padding-bottom: 40px !important;\n    }\n--> <!--\nbody {\n    position: relative;\n}\n\n/*header bg fix*/\n@media (min-width:1250px ) and (max-width: 1364px){\n\t.headerContainer {\n\t    width: 100%;\n\t}\n}\n/*Carousel FW*/\n#container + .container {\n\tmax-width: none !important;\n\twidth: auto!important;\n}\n.slide-transfer {\n    display:none!important;\n}\n.video-wrapper {\n\tmax-height: none !important;\n}\n.carousel-caption {\n\tdisplay: none;\n}\n.slide-transfer {\n\tdisplay: none;\n}\n/*FullWidthSection*/\n.fw-section {\n\tpadding-top: 40px;\n\tpadding-bottom: 60px;\n}\n.sectionAnchor