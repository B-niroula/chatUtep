out(function () {\n                    if (!$(document.activeElement).closest('#myutep-search').length) {\n                        $('#myutep-search').slideUp();\n                        $body.removeClass('search-engaged');\n                        window.searching = false;\n                    }\n                }, 0);\n            });\n\n                function updateText(event) {\n                    var input = $(this);\n                    setTimeout(function () {\n                        var val = input.val();\n                        if (val != \"\")\n                            input.parent().addClass('floating-label');\n\n                        else\n                            input.parent().removeClass('floating-label');\n\n                    }, 100);\n                }\n                $('#myutep-search input').keydown(updateText);\n                $('#myutep-search input').change(updateText);\n                $('#dashboard-space').on('keydown', 'input.portlet-search', updateText);\n                $('#dashboard-space').on('change', 'input.portlet-search', updateText);\n                $('#dashboard-secondary-space').on('keydown', 'input.portlet-search', updateText);\n                $('#dashboard-secondary-space').on('change', 'input.portlet-search', updateText);\n            }); Miner Alerts Registration Close modal window To receive emergency alerts via Miner Alert activate your Miner Alert profile, fill in the appropriate fields above. Any information submitted is strictly used by the UTEP emergency Office of Emergency Management and will not be shared in any manner. oem@utep.edu Main Content Sign in to view your finances, grades, classes, and more Sign In $(function () { $(\"#for-students\").Dashboard({ staticColumnsID: \"col_\", staticWidgetID: \"wid_\", connectedWith: \"none\", drag: \"false\", Type: \"links\", url: \"/My/Dashboard/for-students\", order: \"BOTTOM\" }) }); $(function () { $(\"#for-facultyandstaff\").Dashboard({ staticColumnsID: \"col2_\", staticWidgetID: \"wid2_\", connectedWith: \"none\", drag: \"false\", Type: \"links\", url: \"/My/Dashboard/for-faculty-staff\", order: \"BOTTOM\" }) }); For Students For Faculty & Staff $(function () {\n            setTimeout(function () { $(\".bounce\").hide(); }, 10000);\n            $(document).scroll(function () {\n                var top_of_element = $(\"#dates-events-container\").offset().top + 250;\n                var bottom_of_screen = $(window).scrollTop() + $(window).height();\n                if (bottom_of_screen > top_of_element)\n                {\n                    $(\".bounce\").hide();\n                }\n            })\n            var setToolTipOffset = function() {\n                var list = $(\".for-lnk-list:visible\");\n                var offset = list.find(\"li:first\").width() + 20;\n                $(\".app-tooltip-2\").css(\"left\", offset);\n            };\n            var loadedDashboards = { \"for-students\": false, \"for-facultyandstaff\": false };\n            $(window).on(\"dashboard-loaded\", function(e, dashboardId) {\n                loadedDashboards[dashboardId] = true;\n                if(loadedDashboards[\"for-students\"] && loadedDashboards[\"for-facultyandstaff\"]) {\n                    $(window).resize(function(){\n                        setToolTipOffset();\n                    });\n                    setToolTipOffset();\n                }\n            });\n        }); Campus Resources Academics Health & Safety Finances Employment Technology Campus Resources Technology Health & Safety Training For Faculty Employees Featured $(function () {\n                    var ret = [];\n                    ret.push(\n                        $.ajax({\n                            url: \"/Cascade/NewsContent\",\n                            success: function (data) {\n                                $(\"#featured-slides\").html(data)\n                            },\n                            error: function () {\n                                $(\".owl-carousel\").show();\n                                $(\"#featured-slides\").append(\"<div class=\\\"item unavailable-text\\\"><a class=\\\"error-info\\\" href=\\\"https://www.utep.edu/information-resources/ec/planned-system-outage.html\\\" target=\\\"_blank\\\" rel=\\\"noopener\\\">content is currently unavailable</a></div>\");\n                            }\n                        })\n                    );\n                    $.when.apply($, ret).then(function () {\n                        var owl = $('.featured-slider');\n                        owl.owlCarousel({\n                            loop: true,\n                            video: true,\n                            responsiveClass: true,\n                            dots: true,\n                            autoplay: true,\n                            nav: true,\n                            animateOut: 'fadeOut',\n                            margin: .6,\n                            autoplayHoverPause: true,\n                            navContainer: '#slider-nav',\n                            dotsContainer: '#slider-dots',\n                            navText: ['<span  class=\\\"UtepIcons icon-caret-left\\\" style=\\\"margin-left: 20px\\\"><span class=\\\"off-screen\\\">Previous Slides</span></span>', '<span class=\\\"UtepIcons icon-caret-right\\\" style=\\\"margin-right: 20px\\\"><span class=\\\"off-screen\\\">Next Slides</span></span>'],\n                            responsive: {\n                                0: {\n                                    items: 1,\n                                    nav: true\n                                },\n                                600: {\n                                    items: 1,\n                                    nav: true\n                                },\n                                1000: {\n                                    items: 1,\n                                    nav: true\n                                }\n                            }\n                        });\n                        $(\".UtepIcons.owl-dot\").attr(\"aria-pressed\", false)\n                        owl.on('changed.owl.carousel', function (event) {\n                            $(\".UtepIcons.owl-dot\").attr(\"aria-pressed\", false);\n                            $(\".UtepIcons.owl-dot.active\").attr(\"aria-pressed\", true);\n                            updateCurrentText(event.page.index);\n                        });\n                        $(\"#slider-dots button\").each(function (data) {\n                            $(this).attr(\"aria-controls\", \"featured-slides\");\n                            var span = $(this).children(\"span\");\n                            span.addClass(\"off-screen\");\n                        });\n                        updateCurrentText(0);\n                    });\n\n                    function updateCurrentText(current) {\n                        $(\"#slider-dots button\").each(function (data) {\n                            if (data != current) {\n                                $(this).children(\"span\").text(\"Go to slider image \" + (data + 1));\n                            } else {\n                                $(this).children(\"span\").text(\"current slider image \" + (data + 1));\n                            }\n                            \n                        })\n                    }\n                }); Important Dates Upcoming Events content is currently unavailable Loading content is currently unavailable Loading $(function () {\n                var loadLnksFor = function(mid, ulid, ldrid, unavid) {\n                    $.get(\"/Cascade/MainLinks/asjson?page=\" + mid, function(lnks, status){\n                        var cl = $(ulid);\n                        $(ldrid).hide();\n                        cl.append(lnks);\n                    }).fail(function(){\n                        $(ldrid).hide();\n                        $(unavid).show();\n                    });\n                }\n                var important_mid = \"/MainLinks/ImportantDates.html\";\n                loadLnksFor(important_mid, \"#calendar-btn-lst\", \"#imp-ldr\", \"#imp-unav\");\n\n                var upcoming_mid =  \"/MainLinks/UpcomingEvents.html\";\n                loadLnksFor(upcoming_mid, \"#upcm-btn-lst\", \"#up-ldr\", \"#up-unav\");\n            }); UTEP State Reports UT System Customer Service Statement Title IX Required Links Site Feedback The University of Texas at El Paso | 500 West University Avenue | El Paso, Texas 79968 | (915) 747-5000"}
{"url": "https://www.utep.edu/programs/online/?utep-home", "title": "Applied Arts and Science, BAAS", "text": "Online .program-hero-section {\n    background-image: url(_images/banner.jpg);\n  }\n  .program-hero-section-large {\n    background-image: url(_images/banner.jpg);\n    background-color: #041E42;\n    background-position: 70% 50%;\n    min-height: 350px;\n    background-size: cover;\n    background-repeat: no-repeat;\n  }\n  .ph-h1 {\n      margin-top: 35px;\n  }\n    .ph-h1-large {\n        margin: 35px 0px 15px 0;\n        font-family: \"Bebas Neue\", \"Open Sans\", sans-serif;\n        font-size: 100px;\n        line-height: 90px;\n        font-weight: 400;\n        text-transform: uppercase;\n  }\n  .ph-content  {\n      font-size: 17px;\n  }\n  .ph-content-info {\n      font-size: 17px;\n      margin-bottom: 60px;\n      width: 75%;\n  }\n    .phs-mobile-card-show {\n          display: none;\n      }\n      \n  @media screen and (max-width: 1170px){\n    .phs-mobile-card {\n          padding-left: 20px;\n          padding-right: 20px;\n      }\n    }\n  @media screen and (max-width: 991px){\n    .ph-h1-large {\n        margin-bottom: 0px;\n        font-size: 50px;\n        line-height: 50px;\n        }\n    }\n  @media screen and (max-width: 767px) {\n        .program-hero-section {\n          background-image: url(_images/banner-m.jpg);\n          margin-bottom: -40px;\n        }\n      .ph-h1 {\n          margin-top:0;\n      }\n      .ph-h1-large {\n          line-height: 0.9;\n          margin-top:60px;\n          margin-bottom: 15px;\n      }\n    .program-hero-section-large {\n        min-height: 250px;\n    }\n    .phs-mobile-card-hide,\n    .ph-content-info {\n        display:none;\n    }\n    .phs-mobile-card-show {\n        display: block;\n        margin-left: auto;\n        margin-right: auto;\n        margin-bottom: -120px;\n        box-shadow: none;\n        padding: 20px;\n    }\n    .phs-mobile-card-large {\n        position: unset;\n        padding: 0;\n        background-color: transparent;\n        box-shadow: none;\n        color: #ffffff;\n        text-align: left;\n        text-shadow: 2px 1px 5px rgba(0,0,0,0.51);\n        width: 70%;\n    }\n    .phs-mobile-card {\n        position: absolute;\n        left: 20px;\n        top: auto;\n        right: 20px;\n        bottom: 0%;\n        margin-bottom: -42px;\n        padding: 20px 20px 10px 20px;\n        background-color: #fff;\n        box-shadow: 0 0 10px 3px rgba(0, 0, 0, 0.3);\n        color: #041e42;\n        text-align: center;\n    }\n    .nav-hero-wr-large {\n        margin-bottom: 0;\n    }\n}\n @media screen and (max-width: 479px) {\n     .ph-h1-large {\n        font-size: 50px;\n        line-height: 0.9;\n    }\n } Search Degrees shOw Filters HIDE FILTERS Filter by Interest Art & Design Business, Management, & Marketing Communication & Media Computer & Technology Education & Social Services Professions Engineering Entrepreneurship & Innovation Health Professions & Clinical Sciences Humanities, Languages, & Literature Music, Visual Arts, & Performing Science Social & Behavioral Sciences STEM Applied Arts and Science, BAAS College of Liberal Arts Bilingual Education, M.Ed. College of Education Bilingual Special Education, M.Ed. College of Education Business Administration, MBA Woody L. Hunt College of Business Chicano Studies, B.A. College of Liberal Arts Construction Management, M.S. College of Engineering Creative Writing, MFA College of Liberal Arts Criminal Justice, B.A. College of Liberal Arts Defense & Strategic Studies, MDSS College of Liberal Arts Diversity, Equity and Social Justice in Education, M.A College of Education Early Childhood Care and Education, B.S. College of Education Early Childhood Education, M.Ed. College of Education General Business, BBA Woody L. Hunt College of Business Linguistic Diversity and Educational Equity, M.A. College of Education Literacy Education, M.Ed. College of Education Media Advertising, B.A. College of Liberal Arts Multidisciplinary Studies, BMS College of Liberal Arts Multidisciplinary Studies, MMS Graduate School Music, M.M. College of Liberal Arts Nurse Practitioner, MSN College of Nursing Nursing Administration and Management, MSN College of Nursing Nursing Education, MSN College of Nursing Nursing, RN-to-BSN College of Nursing Organizational and Corporate Communication, B.A. College of Liberal Arts Public Administration, MPA College of Liberal Arts Security Studies, B.A. College of Liberal Arts Social Work, MSW College of Health Sciences STEM Education, M.A. College of Education Systems Engineering, M.S. College of Engineering Quick Links MY UTEP Library Events Calendar Parking and Transportation University Bookstore UTEP Directory UTEP News Campus Map Admissions Undergraduate Graduate Online Public Course Information Resources Cares Act Compliance Clery Crime Statistics Emergency Information Employment Mental Health Resources Texas Veterans Portal Info Center Report Fraud Required Links State Reports Title IX Reporting Title IX Sexual Misconduct Policy UT System Web Accessibility Web Privacy Policy 500 West University Avenue | El Paso, TX 79968 | 915-747-5000 Search pages and people Apply Visit Request Info Current Students Faculty/Staff ABOUT UTEP Financial Aid Research Athletics Giving Admissions $(document).ready(function(){\n  $(\"#myInput\").on(\"keyup\", function() {\n    var value = $(this).val().toLowerCase();\n    $(\".programs-grid a\").filter(function() {\n      $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1);\n    });\n  });\n});\nfunction addHideLabel () {\n\t$(this).parent().addClass('hideLabel');\n}\nfunction removeHideLabel () {\n\tlet searchValue = $(this).val();\n\tif (searchValue != \"\") {\n\t\t$(this).parent().addClass('hideLabel');\n\t} else {\n\t\t$(this).parent().removeClass(\"hideLabel\");\n\t}\n}\n$('#search-query').focus(addHideLabel);\n$('#search-query').blur(removeHideLabel);\n$('#myInput').focus(addHideLabel);\n$('#myInput').blur(removeHideLabel); var allCheckboxes = document.querySelectorAll('input[type=checkbox]');\nvar allPrograms = Array.from(document.querySelectorAll('.program-card'));\nvar checked = {};\ngetChecked('filterByInterest');\nArray.prototype.forEach.call(allCheckboxes, function (el) {\n  el.addEventListener('change', toggleCheckbox);\n});\nfunction toggleCheckbox(e) {\n  getChecked(e.target.name);\n  setVisibility();\n}\nfunction getChecked(name) {\n  checked[name] = Array.from(document.querySelectorAll('input[name=' + name + ']:checked')).map(function (el) {\n    return el.value;\n  });\n}\nfunction setVisibility() {\n  allPrograms.map(function (el) {\n    var filterByInterest = checked.filterByInterest.length ? _.intersection(Array.from(el.classList), checked.filterByInterest).length : true;\n    if (filterByInterest) {\n      el.style.display = 'block';\n    } else {\n      el.style.display = 'none';\n    }\n  });\n} var urlSearchValue;\nvar interestsBox;\n\n$(document).ready(function(){\n\n  // Function to get the search value from the URL\n  function getSearchValueFromURL(parameterName) {\n}\n\n\n\n  // Function to get the search value from the URL and pass it to query search\n  function getSearchValueFromURL(parameterName) {\n    const urlParams = new URLSearchParams(window.location.search);\n    const parameterValue = urlParams.get(parameterName);\n\n    if (parameterValue) {\n      return parameterValue || '';\n    }\n  }\n\n  // Get the search value from the URL\n  urlSearchValue = getSearchValueFromURL('search-query');\n\n    \n  // Set the input field value and filter elements based on the search value\n  if (urlSearchValue && urlSearchValue.trim().length > 0) {\n    let queryLabel = document.querySelector(\".search-wr\");\n    let queryLabelChild = queryLabel.firstElementChild;\n    urlSearchValue= urlSearchValue.replace(/-/g,' ');\n    $('#myInput').val(urlSearchValue);\n    \n    $(\".programs-grid a\").filter(function() {\n      $(this).toggle($(this).text().toLowerCase().indexOf(urlSearchValue) > -1);\n    });\n    queryLabelChild.classList.add(\"hideLabel\");\n  }\n  \n    function getSearchValueFromURL(parameterName) {\n      const urlParams = new URLSearchParams(window.location.search);\n      const parameterValue = urlParams.get(parameterName);\n    \n      if (parameterValue) {\n        return parameterValue || '';\n      }\n    }\n    \n    function setCheckboxBasedOnInterests() {\n      const urlParams = new URLSearchParams(window.location.search);\n      const parametersParent = document.querySelector('.filters-wr');\n      if (parametersParent) {\n        urlParams.forEach((value, name) => {\n          if (name.startsWith('interest')) {\n            let checkboxId = value.toLowerCase();\n            checkboxId = checkboxId.replace(/-/g, ' ').replace(/and/g, '&');\n            if (checkboxId == 'science') {\n              const checkbox = document.getElementById('science');\n              checkbox.checked = true;\n              const changeEvent = new Event('change', { bubbles: true, cancelable: false });\n              checkbox.dispatchEvent(changeEvent);\n            } else {\n              Array.from(parametersParent.querySelectorAll('div > input[type=\"checkbox\"]')).forEach(checkbox => {\n                const parentDiv = checkbox.parentElement;\n                if (parentDiv && parentDiv.textContent.toLowerCase().replace(/,/g,'').includes(checkboxId)) {\n                  checkbox.checked = true;\n                  const changeEvent = new Event('change', { bubbles: true, cancelable: false });\n                  checkbox.dispatchEvent(changeEvent);\n                }\n              });\n            }\n          }\n        });\n      }\n    }\n    setCheckboxBasedOnInterests();\n\n  // Keyup event listener for the search input\n  $(\"#myInput\").on(\"keyup\", function() {\n    var value = $(this).val().toLowerCase();\n    \n    urlSearchValue = value;\n    \n    updateURL(urlSearchValue,interestsBox);\n    $(\".programs-grid a\").filter(function() {\n      $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1);\n    });\n  });\n});\n\nfunction addHideLabel () {\n\t$(this).parent().addClass('hideLabel');\n}\n\nfunction removeHideLabel () {\n\tlet searchValue = $(this).val();\n\tif (searchValue != \"\") {\n\t\t$(this).parent().addClass('hideLabel');\n\t} else {\n\t\t$(this).parent().removeClass(\"hideLabel\");\n\t}\n}\n$('#search-query').focus(addHideLabel);\n$('#search-query').blur(removeHideLabel);\n$('#myInput').focus(addHideLabel);\n$('#myInput').blur(removeHideLabel); function updateURL(searchValue, interests) {\n  const urlParams = new URLSearchParams();\n  if (searchValue && searchValue.trim().length > 0) {\n    urlParams.set('search-query', searchValue.trim().replace(/\\+/g,' ').replace(/-/g,' '));\n  }\n\n  if (interests && interests.length > 0) {\n    interests.forEach((interest, index) => {\n      urlParams.set(`interest${index + 1}`, interest.toLowerCase());\n    });\n  }\n\n  const newURL = `${window.location.pathname}?${urlParams.toString()}`;\n\n  history.pushState(null, '', newURL);\n}\nfunction handleCheckboxChange() {\n  const checkedCheckboxes = document.querySelectorAll('input[name=\"filterByInterest\"]:checked');\n  const interests = Array.from(checkedCheckboxes).map(checkbox => checkbox.value);\n  interestsBox=interests;\n  updateURL(urlSearchValue, interests);\n\n} var allCheckboxes = document.querySelectorAll('input[type=checkbox]');\nvar allPrograms = Array.from(document.querySelectorAll('.program-card'));\nvar checked = {};\ngetChecked('filterByInterest');\nArray.prototype.forEach.call(allCheckboxes, function (el) {\n  el.addEventListener('change', toggleCheckbox);\n  el.addEventListener('toggle', toggleCheckbox);\n});\nArray.from(allCheckboxes).forEach(checkbox => {\n  checkbox.addEventListener('change', handleCheckboxChange);\n});\nfunction toggleCheckbox(e) {\n  getChecked(e.target.name);\n  setVisibility();\n}\nfunction getChecked(name) {\n  checked[name] = Array.from(document.querySelectorAll('input[name=' + name + ']:checked')).map(function (el) {\n    return el.value;\n  });\n}\nfunction setVisibility() {\n  allPrograms.map(function (el) {\n    var filterByInterest = checked.filterByInterest.length ? _.intersection(Array.from(el.classList), checked.filterByInterest).length : true;\n    if (filterByInterest) {\n      el.style.display = 'block';\n    } else {\n      el.style.display = 'none';\n    }\n  });\n} (function(sidr) {\n    \"use strict\"\n    sidr.new('#simple-menu', {\n      displace: false,\n      side: 'right'\n    });\n    document.getElementById('overlay').addEventListener('click', function () {\n      sidr.close('sidr');\n    }, false);\n    document.getElementById('close-menu-button').addEventListener('click', function () {\n      sidr.close('sidr');\n    }, false);\n  })(window.sidr);"}
